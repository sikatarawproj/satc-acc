{
  "name": "wholesale-sales-management",
  "version": "1.0.0",
  "description": "Wholesale Sales Management & SOA System for Sikat Araw Trading Corp.",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.js --dev",
    "build": "node scripts/build.js",
    "start": "vercel dev",
    "lint": "eslint api/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config tests/vitest.config.js",
    "test:watch": "vitest --config tests/vitest.config.js",
    "test:coverage": "vitest run --config tests/vitest.config.js --coverage",
    "vercel-build": "node scripts/build.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vercel": "^37.0.0",
    "vitest": "^4.1.10"
  }
}
